    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.2",
    "astro-icon": "^1.2.0",
    "preact": "^10.29.8",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.1"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^22.20.2",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.130.0"
  }
