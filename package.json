{
  "name": "sf6-combo_viewer",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "vite-node scripts/validate.ts",
    "promote-draft": "vite-node scripts/promote-draft.ts",
    "damage:audit": "vite-node scripts/damage-audit.ts",
