---
import type { Step } from '../data/types';
import { moveByKey, stepModernCommand } from '../data';
import Sequence from './notation/Sequence.astro';

interface Props {
  steps: Step[];
  /** 技辞典のフレーム（発生／ヒット／ガード）を各手順に添える */
  showFrames?: boolean;
}
const { steps, showFrames = false } = Astro.props;
---

<ol class="steps">
  {
    steps.map((st) => {
      const mv = st.moveKey ? moveByKey.get(st.moveKey) : undefined;
      return (
        <li class="step">
          <span class="idx">{st.cancel ? '›' : ''}</span>
          <span class="body">
            <span class="cmd">
              <Sequence command={st.command} commandModern={stepModernCommand(st)} />
            </span>
            <span class="move">{st.move}</span>
            {st.note && <span class="note">— {st.note}</span>}
            {showFrames && mv && (mv.startup != null || mv.onHit || mv.onBlock) && (
              <span class="frames">
                {mv.startup != null && <span>発生 {mv.startup}</span>}
                {mv.onHit && <span>ヒット {mv.onHit}</span>}
                {mv.onBlock && <span>ガード {mv.onBlock}</span>}
              </span>
            )}
          </span>
        </li>
      );
    })
  }
</ol>

<style>
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: step;
  }
  .step {
    display: flex;
    gap: 0.5rem;
    padding: 0.45rem 0;
    border-bottom: 1px dashed var(--border);
  }
  .step:last-child {
    border-bottom: 0;
  }
  .idx {
    flex: none;
    width: 1rem;
    text-align: center;
    color: var(--accent);
    font-family: var(--font-pixel);
  }
  .body {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
  }
  .cmd {
    font-size: 1.05rem;
  }
  .move {
    color: var(--text-dim);
    font-size: 0.9rem;
  }
  .modern {
    font-size: 0.78rem;
    color: var(--text-faint);
    border: 1px solid var(--border);
    padding: 0 0.35em;
  }
  .note {
    font-size: 0.82rem;
    color: var(--text-faint);
  }
  .frames {
    display: inline-flex;
    gap: 0.5em;
    font-size: 0.74rem;
    color: var(--text-faint);
    font-family: var(--font-pixel);
  }
  .frames span {
    white-space: nowrap;
  }
</style>
