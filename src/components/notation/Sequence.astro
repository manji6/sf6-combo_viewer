---
import { deriveModern } from '../../lib/notation/parse';
import Tokens from './Tokens.astro';

interface Props {
  /** クラシックの numpad 正準表記 */
  command: string;
  /** モダン操作のコマンド（あれば）。無ければクラシックから自動推定 */
  commandModern?: string;
  class?: string;
}
const { command, commandModern, class: className = '' } = Astro.props;
const modern = commandModern && commandModern.trim() ? commandModern.trim() : deriveModern(command);
const sameCmd = modern === command;
---

<span class={`nt ${className}`.trim()}>
  <span class="nt-ctl nt-ctl-classic"><Tokens command={command} /></span>
  <span class="nt-ctl nt-ctl-modern" data-fallback={sameCmd ? 'true' : undefined}>
    <Tokens command={modern} />
  </span>
</span>

<style>
  .nt {
    display: inline;
  }
</style>
