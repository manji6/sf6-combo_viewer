---
import type { Combo } from '../data/types';
import { getSituation } from '../data';
import { comboStarterMove, flattenCombo } from '../lib/graph/derive';
import { POSITION_LABEL } from '../lib/ui';
import ComboCard from './ComboCard.astro';

interface Props {
  combos: Combo[];
}
const { combos } = Astro.props;

const enriched = combos.map((combo) => {
  const flat = flattenCombo(combo);
  const start = getSituation(combo.startFrom);
  const starter = comboStarterMove(combo);
  return { combo, flat, start, starter };
});

const positions = [...new Set(enriched.map((e) => e.start.position))];
const starterMoves = [...new Set(enriched.map((e) => e.starter?.label).filter(Boolean))] as string[];
const allTags = [...new Set(enriched.flatMap((e) => e.combo.tags))].sort();

function driveBucket(n: number) {
  if (n <= 0) return '0';
  if (n <= 2) return '1-2';
  return '3+';
}
---

<div class="explorer" data-explorer>
  <form class="filters pixel-box" data-filters aria-label="コンボの絞り込み">
    <fieldset class="fgroup">
      <legend class="flabel">立ち位置</legend>
      {
        positions.map((p) => (
          <label class="chip">
            <input type="checkbox" name="pos" value={p} />
            {POSITION_LABEL[p]}
          </label>
        ))
      }
    </fieldset>

    <fieldset class="fgroup">
      <legend class="flabel">始動技</legend>
      {
        starterMoves.map((m) => (
          <label class="chip">
            <input type="checkbox" name="starter" value={m} />
            {m}
          </label>
        ))
      }
    </fieldset>

    <fieldset class="fgroup">
      <legend class="flabel">Dゲージ</legend>
      <label class="chip"><input type="checkbox" name="drive" value="0" />ノーゲージ</label>
      <label class="chip"><input type="checkbox" name="drive" value="1-2" />1〜2</label>
      <label class="chip"><input type="checkbox" name="drive" value="3+" />3以上</label>
    </fieldset>

    <fieldset class="fgroup">
      <legend class="flabel">SA</legend>
      <label class="chip"><input type="checkbox" name="sa" value="yes" />使用</label>
      <label class="chip"><input type="checkbox" name="sa" value="no" />不使用</label>
    </fieldset>

    <fieldset class="fgroup">
      <legend class="flabel">操作</legend>
      <label class="chip"><input type="checkbox" name="modern" value="yes" />モダン可</label>
    </fieldset>

    <fieldset class="fgroup tags">
      <legend class="flabel">タグ</legend>
      {
        allTags.map((t) => (
          <label class="chip">
            <input type="checkbox" name="tag" value={t} />
            {t}
          </label>
        ))
      }
    </fieldset>

    <div class="fgroup sortrow">
      <label class="flabel" for="combo-sort">並べ替え</label>
      <select id="combo-sort" name="sort" data-sort>
        <option value="damage">ダメージが高い順</option>
        <option value="diff-asc">難易度が低い順</option>
        <option value="diff-desc">難易度が高い順</option>
        <option value="name">名前順</option>
      </select>
      <button type="button" class="btn reset" data-reset>クリア</button>
    </div>
  </form>

  <p class="count" data-count></p>

  <div class="grid" data-grid>
    {
      enriched.map(({ combo, flat, start, starter }) => (
        <div
          class="grid-item"
          data-item
          data-pos={start.position}
          data-starter={starter?.label ?? ''}
          data-drive={driveBucket(flat.totalDrive)}
          data-sa={flat.totalSuper > 0 ? 'yes' : 'no'}
          data-modern={flat.supportsModern ? 'yes' : 'no'}
          data-tags={combo.tags.join('|')}
          data-damage={flat.totalDamage}
          data-diff={combo.difficulty}
          data-name={combo.name}
        >
          <ComboCard combo={combo} />
        </div>
      ))
    }
  </div>
  <p class="empty" data-empty hidden>条件に一致するコンボがありません。</p>
</div>

<style>
  .filters {
    padding: 0.8rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .fgroup {
    position: relative;
    padding-left: 6.2em;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    align-content: flex-start;
    gap: 0.35rem;
    min-height: 1.9em;
    /* R09: <fieldset> の既定枠・余白を解除して見た目を維持する */
    border: 0;
    margin: 0;
  }
  /* R09: 12.5px 相当で --text-faint（3.56:1）は AA(4.5:1) 未達だったため --text-dim に変更 */
  .flabel {
    position: absolute;
    left: 0;
    top: 0.35em;
    width: 5.8em;
    font-family: var(--font-pixel);
    font-size: 0.78rem;
    color: var(--text-dim);
    line-height: 1.3;
    padding: 0; /* <legend> の既定余白を解除 */
  }
  @media (max-width: 480px) {
    .fgroup {
      padding-left: 0;
    }
    .flabel {
      position: static;
      width: 100%;
      margin-bottom: 0.1rem;
    }
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    font-size: 0.8rem;
    padding: 0.15em 0.55em;
    border: 1px solid var(--border-strong);
    background: var(--bg-raised);
    cursor: pointer;
    user-select: none;
  }
  .chip:has(:checked) {
    background: var(--accent);
    color: var(--accent-ink);
    border-color: var(--accent);
  }
  .chip input {
    accent-color: var(--accent-ink);
    margin: 0;
  }
  .sortrow select {
    font-family: var(--font-body);
    padding: 0.25em 0.5em;
    background: var(--bg-raised);
    color: var(--text);
    border: 1px solid var(--border-strong);
  }
  .reset {
    padding: 0.2em 0.7em;
    font-size: 0.78rem;
    box-shadow: none;
  }
  /* R09: 12.8px 相当で --text-faint（4.20:1 / light 4.18:1）は AA(4.5:1) 未達だったため変更 */
  .count {
    font-size: 0.8rem;
    color: var(--text-dim);
    margin: 0.8rem 0 0.4rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(320px, 100%), 1fr));
    gap: 0.9rem;
  }
  .grid-item.hidden {
    display: none;
  }
  .empty {
    padding: 2rem;
    text-align: center;
    color: var(--text-dim);
  }
</style>

<script>
  type ItemEl = HTMLElement;

  document.querySelectorAll<HTMLElement>('[data-explorer]').forEach((root) => {
    const form = root.querySelector<HTMLFormElement>('[data-filters]')!;
    const grid = root.querySelector<HTMLElement>('[data-grid]')!;
    const items = [...root.querySelectorAll<ItemEl>('[data-item]')];
    const countEl = root.querySelector<HTMLElement>('[data-count]')!;
    const emptyEl = root.querySelector<HTMLElement>('[data-empty]')!;
    const sortEl = form.querySelector<HTMLSelectElement>('[data-sort]')!;
    const GROUPS = ['pos', 'starter', 'drive', 'sa', 'modern', 'tag'] as const;
    const SORTS = ['damage', 'diff-asc', 'diff-desc', 'name'];
    const DEFAULT_SORT = 'damage';

    // R11: sort が省略・不正な URL でも既定値へ正規化する（前回の select 値を残さない）
    function readURL() {
      const q = new URLSearchParams(location.search);
      GROUPS.forEach((g) => {
        const vals = (q.get(g) ?? '').split(',').filter(Boolean);
        form
          .querySelectorAll<HTMLInputElement>(`input[name="${g}"]`)
          .forEach((i) => (i.checked = vals.includes(i.value)));
      });
      const sort = q.get('sort');
      sortEl.value = sort && SORTS.includes(sort) ? sort : DEFAULT_SORT;
    }

    function writeURL() {
      const q = new URLSearchParams();
      GROUPS.forEach((g) => {
        const vals = [
          ...form.querySelectorAll<HTMLInputElement>(`input[name="${g}"]:checked`),
        ].map((i) => i.value);
        if (vals.length) q.set(g, vals.join(','));
      });
      if (sortEl.value !== DEFAULT_SORT) q.set('sort', sortEl.value);
      const s = q.toString();
      // タブの #hash は残す
      history.replaceState(null, '', (s ? `?${s}` : location.pathname) + location.hash);
    }

    function selected(group: string): string[] {
      return [
        ...form.querySelectorAll<HTMLInputElement>(`input[name="${group}"]:checked`),
      ].map((i) => i.value);
    }

    function match(it: ItemEl): boolean {
      const pos = selected('pos');
      const starter = selected('starter');
      const drive = selected('drive');
      const sa = selected('sa');
      const modern = selected('modern');
      const tags = selected('tag');
      if (pos.length && !pos.includes(it.dataset.pos!)) return false;
      if (starter.length && !starter.includes(it.dataset.starter!)) return false;
      if (drive.length && !drive.includes(it.dataset.drive!)) return false;
      if (sa.length && !sa.includes(it.dataset.sa!)) return false;
      if (modern.length && it.dataset.modern !== 'yes') return false;
      if (tags.length) {
        const own = (it.dataset.tags ?? '').split('|');
        if (!tags.every((t) => own.includes(t))) return false;
      }
      return true;
    }

    // R11: フィルタ・ソートの反映（DOM 更新のみ）と、URL への書き込みを分離する。
    // popstate（戻る／進む）は URL を読むだけで、render() の結果を再度 URL に書き戻さない。
    function render() {
      const sort = sortEl.value;
      const sorted = [...items].sort((a, b) => {
        if (sort === 'damage') return +b.dataset.damage! - +a.dataset.damage!;
        if (sort === 'diff-asc') return +a.dataset.diff! - +b.dataset.diff!;
        if (sort === 'diff-desc') return +b.dataset.diff! - +a.dataset.diff!;
        return a.dataset.name!.localeCompare(b.dataset.name!, 'ja');
      });
      let visible = 0;
      sorted.forEach((it) => {
        const ok = match(it);
        it.classList.toggle('hidden', !ok);
        if (ok) visible++;
        grid.appendChild(it);
      });
      countEl.textContent = `${visible} / ${items.length} 件`;
      emptyEl.hidden = visible > 0;
    }

    /** ユーザー操作（フィルタ変更・クリア）による反映。URL にも書く */
    function apply() {
      render();
      writeURL();
    }

    form.addEventListener('change', apply);
    root.querySelector('[data-reset]')?.addEventListener('click', () => {
      form.reset();
      apply();
    });
    window.addEventListener('popstate', () => {
      readURL();
      render();
    });

    readURL();
    render();
  });
</script>
