---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SystemMap from '../../components/islands/SystemMap.tsx';
import { characterById } from '../../data/characters';
import { characters, combos, routes, situations } from '../../data';
import { fullGraph } from '../../lib/graph/systemmap';

export function getStaticPaths() {
  return characters.map((c) => ({ params: { character: c.id } }));
}

const character = characterById.get(Astro.params.character)!;
const elements = fullGraph(character.id);
const charCombos = combos.filter((c) => c.character === character.id);
const charRoutes = routes.filter((r) => r.character === character.id);
const charSituations = situations.filter((s) => s.character === character.id);
---

<BaseLayout
  title="相関グラフ"
  crumbs={[{ label: character.name, href: `/${character.id}/` }, { label: '相関グラフ' }]}
>
  <header class="head">
    <h1>相関グラフ</h1>
    <p>
      状況ノード（{charSituations.length}）とパーツ（{charRoutes.length}）のつながり。
      同じ状況ノードを複数のパーツが共有していることで、コンボと起き攻めが連結されます。
      コンボ数 {charCombos.length}。
    </p>
  </header>

  {
    elements.nodes.length === 0 ? (
      <p class="empty">まだ登録がありません（実データ投入中）。</p>
    ) : (
      <div class="full-bleed">
        <div class="full-bleed-inner">
          <SystemMap client:only="preact" elements={elements} characterId={character.id} height={720}>
            <div slot="fallback" class="island-loading" style="height:720px">
              相関グラフを準備中…
            </div>
          </SystemMap>
        </div>
      </div>
    )
  }

  <section class="legend-note">
    <h2>読み方</h2>
    <ul>
      <li>丸 = 状況ノード（ニュートラル・ヒット・浮き・ダウンなど）。色は種類。</li>
      <li>矢印 = パーツ（技の連なり）。色は役割（始動・中継・起き攻め・締め）。</li>
      <li>
        <strong>「4強P → 中ランヴェルセ が繋がる浮き」</strong>ノードに注目。
        起き攻めの DR2中K と、頻出コンボの 5中P DRC 2中P が
        <em>どちらもここへ入り</em>、同じ締めパーツを共有しています。
      </li>
      <li>クリックで各詳細ページへ。ホイールで拡大縮小、ドラッグで移動。</li>
    </ul>
  </section>
</BaseLayout>

<style>
  .empty {
    padding: 3rem;
    text-align: center;
    color: var(--text-faint);
  }
  .head {
    margin-bottom: 1rem;
  }
  .head h1 {
    margin: 0 0 0.3rem;
    color: var(--accent);
  }
  .head p {
    margin: 0;
    font-size: 0.9rem;
    color: var(--text-dim);
  }
  .legend-note {
    margin-top: 1.5rem;
  }
  .legend-note h2 {
    font-size: 1rem;
    border-bottom: 2px solid var(--border-strong);
    padding-bottom: 0.25rem;
  }
  .legend-note ul {
    font-size: 0.88rem;
    color: var(--text-dim);
    padding-left: 1.1rem;
  }
  .legend-note li {
    padding: 0.2rem 0;
  }
</style>
