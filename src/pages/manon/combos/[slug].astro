---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import StepCmd from '../../../components/notation/StepCmd.astro';
import Stars from '../../../components/Stars.astro';
import FlowCanvas from '../../../components/islands/FlowCanvas.tsx';
import { combos, getRoute, getSituation } from '../../../data';
import {
  combosUsingRoute,
  comboSupportsModern,
  flattenCombo,
  outgoingRoutes,
} from '../../../lib/graph/derive';
import { buildComboFlow } from '../../../lib/graph/flow';
import { driveLabel, ROUTE_KIND_LABEL, superLabel } from '../../../lib/ui';

export function getStaticPaths() {
  return combos.map((c) => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const combo = combos.find((c) => c.slug === slug)!;
const flat = flattenCombo(combo);
const chainRoutes = combo.routeChain.map(getRoute);
const end = getSituation(combo.endAt);
const supportsModern = comboSupportsModern(combo);
const flow = buildComboFlow(combo, 'classic');
const flowModern = supportsModern ? buildComboFlow(combo, 'modern') : undefined;

const partUsage = chainRoutes.map((r) => ({
  route: r,
  others: combosUsingRoute(r.id).filter((c) => c.slug !== combo.slug),
}));
const endOki = outgoingRoutes(end.id).filter((r) => r.kind === 'okizeme');
---

<BaseLayout
  title={combo.name}
  description={combo.description}
  crumbs={[{ label: 'マノン', href: '/manon/' }, { label: combo.name }]}
>
  <article class="stack" style="--gap:1.6rem">
    <header class="c-head">
      <h1>{combo.name}</h1>
      <p class="sit">{combo.situationLabel}</p>
      {combo.description && <p class="desc">{combo.description}</p>}
      <div class="stat-row">
        <div class="stat">
          <span class="k">ダメージ</span>
          <span class="v">{flat.totalDamage.toLocaleString()}</span>
          {combo.damageNote && <span class="sub">{combo.damageNote}</span>}
        </div>
        <div class="stat"><span class="k">難易度</span><span class="v"><Stars value={combo.difficulty} showNumber /></span></div>
        <div class="stat"><span class="k">Dゲージ</span><span class="v">{driveLabel(flat.totalDrive)}</span></div>
        <div class="stat"><span class="k">SA</span><span class="v">{superLabel(flat.totalSuper, flat.maxSaLevel)}</span></div>
        <div class="stat"><span class="k">操作</span><span class="v">{supportsModern ? 'クラシック / モダン' : 'クラシックのみ'}</span></div>
      </div>
      <div class="tags">{combo.tags.map((t) => <span class="tag">{t}</span>)}</div>
    </header>

    <section>
      <h2>コンボフロー</h2>
      <p class="lead">
        左から右へコマンドが流れます。実線＝コンボ本線、水色＝分岐（別の締めなど）、
        破線＝締めからの起き攻め。
        {supportsModern
          ? 'このコンボはモダンでも可能。ツールバーで表記を切替（モダン限定/クラシック限定のパーツは表示が変わります）。'
          : 'このコンボはクラシックのみ。'}
      </p>
      <div class="full-bleed">
        <div class="full-bleed-inner">
          <FlowCanvas client:only="preact" graph={flow} graphModern={flowModern} height={860}>
            <div slot="fallback" class="island-loading" style="height:860px">
              コンボフローを準備中…
            </div>
          </FlowCanvas>
        </div>
      </div>
    </section>

    <details class="text-recipe">
      <summary>テキストで見る</summary>
      <div class="tr-body scroll-x">
        {
          flat.steps.map((st, i) => (
            <>
              {i > 0 && <span class="j">{st.boundary ? '»' : '›'}</span>}
              <StepCmd step={st} />
            </>
          ))
        }
      </div>
    </details>

    <section>
      <h2>パーツと連結</h2>
      <ul class="parts">
        {
          partUsage.map(({ route, others }) => (
            <li class="pixel-box part">
              <div class="p-head">
                <span class="pl-kind">{ROUTE_KIND_LABEL[route.kind]}</span>
                <a href={`/manon/routes/${route.id}/`}>{route.label}</a>
                <span class="p-flow">
                  {getSituation(route.from).label} → {getSituation(route.to).label}
                </span>
              </div>
              {others.length > 0 ? (
                <p class="p-others">
                  このパーツを使う他のコンボ:{' '}
                  {others.map((c, i) => (
                    <>
                      {i > 0 && '、'}
                      <a href={`/manon/combos/${c.slug}/`}>{c.name}</a>
                    </>
                  ))}
                </p>
              ) : (
                <p class="p-others none">このコンボ専用のパーツ</p>
              )}
            </li>
          ))
        }
      </ul>
    </section>

    {
      endOki.length > 0 && (
        <section>
          <h2>締め後の起き攻め</h2>
          <p class="lead">
            <a href={`/manon/situations/${end.id}/`}>{end.label}</a>（{end.advantage}）から {endOki.length} 択。
          </p>
          <ul class="oki-list">
            {endOki.map((r) => (
              <li>
                <span class="dot" data-risk={r.properties?.risk ?? ''} />
                <a href={`/manon/routes/${r.id}/`}>{r.label}</a>
                {r.properties?.useWhen && <span class="uw">— {r.properties.useWhen}</span>}
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
</BaseLayout>

<style>
  .c-head h1 { margin: 0 0 0.3rem; color: var(--accent); }
  .sit { margin: 0; color: var(--text-dim); font-size: 0.9rem; }
  .desc { margin: 0.6rem 0 0; font-size: 0.92rem; }
  .stat-row { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 1rem 0 0.6rem; }
  .stat { border: 1px solid var(--border-strong); background: var(--bg-sunken); padding: 0.35rem 0.7rem; min-width: 6rem; }
  .stat .k { display: block; font-size: 0.68rem; color: var(--text-faint); }
  .stat .v { font-family: var(--font-pixel); color: var(--text); }
  .stat .sub { display: block; margin-top: 0.15rem; font-size: 0.68rem; color: var(--text-faint); max-width: 16rem; }
  h2 { font-size: 1rem; border-bottom: 2px solid var(--border-strong); padding-bottom: 0.25rem; margin: 0 0 0.6rem; }
  .lead { font-size: 0.83rem; color: var(--text-faint); margin: 0 0 0.8rem; }
  .text-recipe > summary { cursor: pointer; font-family: var(--font-pixel); font-size: 0.85rem; color: var(--text-dim); }
  .tr-body { display: flex; align-items: center; gap: 0.4rem; white-space: nowrap; padding: 0.7rem 0; font-size: 1.05rem; }
  .tr-body .j { color: var(--text-faint); }
  .parts { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.6rem; }
  .part { padding: 0.7rem 0.9rem; }
  .p-head { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }
  .pl-kind { background: var(--accent); color: var(--accent-ink); font-family: var(--font-pixel); padding: 0.05em 0.4em; font-size: 0.7rem; }
  .p-flow { font-size: 0.76rem; color: var(--text-faint); }
  .p-others { margin: 0.4rem 0 0; font-size: 0.83rem; color: var(--text-dim); }
  .p-others.none { color: var(--text-faint); }
  .oki-list { list-style: none; padding: 0; margin: 0; }
  .oki-list li { display: flex; align-items: center; gap: 0.5em; padding: 0.25rem 0; font-size: 0.86rem; }
  .oki-list .uw { color: var(--text-faint); font-size: 0.8rem; }
  .dot { width: 9px; height: 9px; flex: none; background: var(--border-strong); }
  .dot[data-risk='低'] { background: var(--risk-low); }
  .dot[data-risk='中'] { background: var(--risk-mid); }
  .dot[data-risk='高'] { background: var(--risk-high); }
</style>
