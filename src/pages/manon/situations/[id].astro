---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import StepCmd from '../../../components/notation/StepCmd.astro';
import Stars from '../../../components/Stars.astro';
import FlowCanvas from '../../../components/islands/FlowCanvas.tsx';
import { getSituation, situations } from '../../../data';
import {
  combosThroughSituation,
  incomingRoutes,
  outgoingRoutes,
} from '../../../lib/graph/derive';
import { buildSituationFlow } from '../../../lib/graph/flow';
import {
  frameAdvLabel,
  OPPONENT_STATE_LABEL,
  POSITION_LABEL,
  RISK_VAR,
  ROUTE_KIND_LABEL,
  SITUATION_KIND_LABEL,
  wakeupSummary,
} from '../../../lib/ui';

export function getStaticPaths() {
  return situations.map((s) => ({ params: { id: s.id } }));
}

const { id } = Astro.params;
const situation = getSituation(id!);
const outs = outgoingRoutes(situation.id);
const okis = outs.filter((r) => r.kind === 'okizeme');
const otherOuts = outs.filter((r) => r.kind !== 'okizeme');
const ins = incomingRoutes(situation.id);
const throughCombos = combosThroughSituation(situation.id);
const hasFlow = okis.length > 0;
const flow = hasFlow ? buildSituationFlow(situation.id, 'classic') : null;
const flowModern = hasFlow ? buildSituationFlow(situation.id, 'modern') : undefined;
const hasClassicOnly = outs.some((r) => r.controlType === 'classic');
---

<BaseLayout
  title={situation.label}
  crumbs={[{ label: 'マノン', href: '/manon/' }, { label: situation.label }]}
>
  <article class="stack" style="--gap:1.6rem">
    <header>
      <h1>{situation.label}</h1>
      <div class="meta">
        <span class="pixel-chip">{SITUATION_KIND_LABEL[situation.kind]}</span>
        <span class="pixel-chip">{POSITION_LABEL[situation.position]}</span>
        <span class="pixel-chip">{OPPONENT_STATE_LABEL[situation.opponentState]}</span>
        {situation.advantage && (
          <span class="pixel-chip">相手復帰まで {situation.advantage}</span>
        )}
        {situation.tags.map((t) => <span class="tag">{t}</span>)}
      </div>
      {situation.wakeupNote && (
        <p class="wakeup">
          <strong>起き上がり:</strong> {situation.wakeupNote}
        </p>
      )}
      {situation.notes && <p class="notes">{situation.notes}</p>}
    </header>

    {
      flow && (
        <section>
          <h2>起き攻め {okis.length} 択（フロー）</h2>
          <p class="lead">
            破線が各択。ヒット後の展開・ループはノードでつながって見えます。
            {hasClassicOnly && 'ツールバーで「モダン」にすると、クラシック限定の択は表示から消えます。'}
          </p>
          <div class="full-bleed">
            <div class="full-bleed-inner">
              <FlowCanvas
                client:only="preact"
                graph={flow}
                graphModern={flowModern}
                height={800}
              />
            </div>
          </div>
        </section>
      )
    }

    {
      okis.length > 0 && (
        <section>
          <h2>各択の特徴</h2>
          <ul class="branch-cards">
            {okis.map((r) => {
              const p = r.properties;
              return (
                <li class="pixel-box bc" style={p?.risk ? `--risk:${RISK_VAR[p.risk]}` : ''}>
                  <div class="bc-head">
                    <a class="bc-title" href={`/manon/routes/${r.id}/`}>
                      {r.label}
                    </a>
                    {r.controlType === 'classic' && <span class="cl-only">クラシック限定</span>}
                    {p?.risk && <span class="risk">リスク{p.risk}</span>}
                  </div>
                  <div class="bc-recipe scroll-x">
                    {r.steps.map((st, i) => (
                      <>
                        {i > 0 && <span class="j">›</span>}
                        <StepCmd step={st} />
                      </>
                    ))}
                  </div>
                  {p && (
                    <dl class="props">
                      {p.frameAdvantage && (
                        <>
                          <dt class="s-frame">初回行動後</dt>
                          <dd>{frameAdvLabel(p.frameAdvantage, { withNote: true })}</dd>
                        </>
                      )}
                      {p.wakeup && (
                        <>
                          <dt>受け身</dt>
                          <dd>{wakeupSummary(p.wakeup)}</dd>
                        </>
                      )}
                      {p.useWhen && (
                        <>
                          <dt>使いどき</dt>
                          <dd>{p.useWhen}</dd>
                        </>
                      )}
                      {p.strongVs?.length ? (
                        <>
                          <dt class="s-good">強い</dt>
                          <dd>{p.strongVs.join(' / ')}</dd>
                        </>
                      ) : null}
                      {p.weakVs?.length ? (
                        <>
                          <dt class="s-bad">弱い</dt>
                          <dd>{p.weakVs.join(' / ')}</dd>
                        </>
                      ) : null}
                      {p.onBlock && (
                        <>
                          <dt>ガード時</dt>
                          <dd>{p.onBlock}</dd>
                        </>
                      )}
                    </dl>
                  )}
                  <div class="bc-foot">
                    <Stars value={r.difficulty} />
                    <span class="to">→ <a href={`/manon/situations/${r.to}/`}>{getSituation(r.to).label}</a></span>
                  </div>
                </li>
              );
            })}
          </ul>
        </section>
      )
    }

    {
      otherOuts.length > 0 && (
        <section>
          <h2>ここから出るパーツ</h2>
          <ul class="route-list">
            {otherOuts.map((r) => (
              <li class="pixel-box">
                <a class="rl-title" href={`/manon/routes/${r.id}/`}>
                  <span class="pl-kind">{ROUTE_KIND_LABEL[r.kind]}</span>
                  {r.label}
                </a>
                <div class="rl-recipe scroll-x">
                  {r.steps.map((st, i) => (
                    <>
                      {i > 0 && <span class="j">›</span>}
                      <StepCmd step={st} />
                    </>
                  ))}
                </div>
                <span class="rl-to">→ {getSituation(r.to).label}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section>
      <h2>ここへ入るパーツ（{ins.length}）</h2>
      {
        ins.length === 0 ? (
          <p class="empty">なし（始動状況）</p>
        ) : (
          <ul class="route-list">
            {ins.map((r) => (
              <li class="pixel-box">
                <a class="rl-title" href={`/manon/routes/${r.id}/`}>
                  <span class="pl-kind">{ROUTE_KIND_LABEL[r.kind]}</span>
                  {r.label}
                </a>
                <div class="rl-recipe scroll-x">
                  {r.steps.map((st, i) => (
                    <>
                      {i > 0 && <span class="j">›</span>}
                      <StepCmd step={st} />
                    </>
                  ))}
                </div>
                <span class="rl-to">{getSituation(r.from).label} →</span>
              </li>
            ))}
          </ul>
        )
      }
    </section>

    {
      throughCombos.length > 0 && (
        <section>
          <h2>この状況を通るコンボ</h2>
          <ul class="combo-links">
            {throughCombos.map((c) => (
              <li>
                <a href={`/manon/combos/${c.slug}/`}>{c.name}</a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
</BaseLayout>

<style>
  h1 { margin: 0 0 0.5rem; color: var(--accent); }
  .meta { display: flex; flex-wrap: wrap; gap: 0.35rem; align-items: center; }
  .notes { margin: 0.7rem 0 0; color: var(--text-dim); font-size: 0.92rem; }
  .wakeup { margin: 0.6rem 0 0; font-size: 0.88rem; color: var(--text); background: var(--bg-sunken); border-left: 3px solid var(--accent); padding: 0.35rem 0.6rem; }
  h2 { font-size: 1rem; border-bottom: 2px solid var(--border-strong); padding-bottom: 0.25rem; margin: 0 0 0.6rem; }
  .lead { font-size: 0.83rem; color: var(--text-faint); margin: 0 0 0.8rem; }

  .branch-cards { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 0.7rem; }
  .bc { padding: 0.7rem 0.85rem; border-left: 6px solid var(--risk, var(--border-strong)); }
  .bc-head { display: flex; align-items: center; gap: 0.5rem; }
  .bc-title { font-family: var(--font-pixel); font-size: 0.92rem; }
  .bc-head .risk { margin-left: auto; font-size: 0.7rem; color: var(--risk, var(--text-faint)); border: 1px solid currentColor; padding: 0.05em 0.4em; }
  .bc-head .cl-only { font-size: 0.66rem; color: var(--btn-l); border: 1px solid currentColor; padding: 0.05em 0.35em; }
  .bc-head .cl-only + .risk { margin-left: 0.3rem; }
  .bc-recipe { display: flex; align-items: center; gap: 0.3rem; white-space: nowrap; padding: 0.5rem 0; font-size: 1rem; }
  .bc-recipe .j { color: var(--text-faint); }
  .props { display: grid; grid-template-columns: max-content 1fr; gap: 0.15rem 0.7rem; margin: 0.2rem 0 0; font-size: 0.8rem; }
  .props dt { color: var(--text-faint); white-space: nowrap; }
  .props dt.s-good { color: var(--risk-low); }
  .props dt.s-bad { color: var(--risk-high); }
  .props dt.s-frame { color: var(--btn-dr); font-weight: 700; }
  .props dd { margin: 0; color: var(--text-dim); }
  .bc-foot { display: flex; justify-content: space-between; align-items: center; margin-top: 0.5rem; flex-wrap: wrap; gap: 0.4rem; }
  .bc-foot .to { font-size: 0.8rem; color: var(--text-faint); }

  .route-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.6rem; }
  .route-list li { padding: 0.65rem 0.85rem; }
  .rl-title { font-family: var(--font-pixel); font-size: 0.92rem; display: inline-flex; align-items: center; gap: 0.5rem; }
  .pl-kind { background: var(--bg-sunken); border: 1px solid var(--border); color: var(--text-dim); font-size: 0.68rem; padding: 0.05em 0.4em; }
  .rl-recipe { display: flex; align-items: center; gap: 0.3rem; white-space: nowrap; padding: 0.4rem 0 0.2rem; font-size: 1rem; }
  .rl-recipe .j { color: var(--text-faint); }
  .rl-to { font-size: 0.78rem; color: var(--text-faint); }
  .combo-links { padding-left: 1.1rem; margin: 0; }
  .combo-links li { padding: 0.2rem 0; }
  .empty { color: var(--text-faint); font-size: 0.88rem; }
</style>
