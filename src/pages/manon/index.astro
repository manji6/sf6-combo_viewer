---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ComboExplorer from '../../components/ComboExplorer.astro';
import { characterById } from '../../data/characters';
import { combos, getSituation, situations } from '../../data';
import { outgoingRoutes } from '../../lib/graph/derive';
import { POSITION_LABEL } from '../../lib/ui';

const character = characterById.get('manon')!;

// コンボ＝始動技から始まる経路（相手の状況を問わない）。
// 始動が「特定状況（ダウン後・パリィ後など）」のものはセットプレイ側で扱う。
const SITUATIONAL = new Set(['knockdown', 'okiStart', 'blockstring']);
const manonCombos = combos.filter(
  (c) => c.character === 'manon' && !SITUATIONAL.has(getSituation(c.startFrom).kind),
);

// セットプレイ＝特定状況から始まる読み合い（起き攻め起点のダウンなど）
const setplayStarts = situations.filter(
  (s) => s.tags.includes('起き攻め開始') && outgoingRoutes(s.id).length > 0,
);
---

<BaseLayout
  title={`${character.name} コンボ・セットプレイ`}
  crumbs={[{ label: character.name }]}
>
  <header class="page-head">
    <h1>{character.name}</h1>
    <p>{character.tagline}</p>
    <p class="ch-links">
      <a href="/manon/graph/">相関グラフ（全体の見取り図）</a>
    </p>
  </header>

  <div class="tabs" data-tabs>
    <div class="tab-bar" role="tablist" aria-label="コンボとセットプレイ">
      <button
        type="button"
        role="tab"
        id="tab-combos"
        aria-controls="panel-combos"
        aria-selected="true"
      >
        コンボ一覧（{manonCombos.length}）
      </button>
      <button
        type="button"
        role="tab"
        id="tab-setplay"
        aria-controls="panel-setplay"
        aria-selected="false"
        tabindex="-1"
      >
        セットプレイ（{setplayStarts.length}）
      </button>
    </div>

    <section
      class="tab-panel"
      id="panel-combos"
      role="tabpanel"
      aria-labelledby="tab-combos"
      tabindex="0"
    >
      <p class="tab-desc">
        <strong>コンボ</strong>＝始動技から始まる伸ばし方。相手の状況を問わず「この技が当たったら
        どこまで伸びるか」。フィルタ／ソートで探せます。
      </p>
      <ComboExplorer combos={manonCombos} />
    </section>

    <section
      class="tab-panel"
      id="panel-setplay"
      role="tabpanel"
      aria-labelledby="tab-setplay"
      tabindex="0"
      hidden
    >
      <p class="tab-desc">
        <strong>セットプレイ</strong>＝特定の状況から始まる読み合い（○○締め後のダウン、△△をジャスト
        パリィした後 など）。各起点で分岐択とその特徴・初回行動後の有利フレームを確認できます。
      </p>
      <ul class="sp-grid">
        {
          setplayStarts.map((s) => {
            const outs = outgoingRoutes(s.id);
            return (
              <li class="sp-card pixel-box">
                <a class="sp-title" href={`/manon/situations/${s.id}/`}>
                  {s.label}
                </a>
                <div class="sp-meta">
                  <span class="pixel-chip">{POSITION_LABEL[s.position]}</span>
                  {s.advantage && <span class="pixel-chip">{s.advantage}</span>}
                  <span class="pixel-chip">{outs.length} 択</span>
                </div>
                <ul class="sp-choices">
                  {outs.map((r) => (
                    <li>
                      <span class="dot" data-risk={r.properties?.risk ?? ''} />
                      {r.label}
                    </li>
                  ))}
                </ul>
              </li>
            );
          })
        }
      </ul>
    </section>
  </div>

  <script>
    document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
      const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
      const panels = new Map(
        tabs.map((t) => [t, document.getElementById(t.getAttribute('aria-controls')!)!]),
      );

      function select(tab: HTMLButtonElement, focus = true) {
        tabs.forEach((t) => {
          const on = t === tab;
          t.setAttribute('aria-selected', String(on));
          t.tabIndex = on ? 0 : -1;
          panels.get(t)!.hidden = !on;
        });
        if (focus) tab.focus();
        const id = tab.id.replace(/^tab-/, '');
        if ((location.hash.slice(1) || 'combos') !== id) {
          history.pushState(null, '', id === 'combos' ? location.pathname + location.search : `#${id}`);
        }
      }

      root.querySelector('[role="tablist"]')!.addEventListener('keydown', (e) => {
        const ev = e as KeyboardEvent;
        const i = tabs.indexOf(document.activeElement as HTMLButtonElement);
        if (i < 0) return;
        let next = -1;
        if (ev.key === 'ArrowRight' || ev.key === 'ArrowDown') next = (i + 1) % tabs.length;
        else if (ev.key === 'ArrowLeft' || ev.key === 'ArrowUp') next = (i - 1 + tabs.length) % tabs.length;
        else if (ev.key === 'Home') next = 0;
        else if (ev.key === 'End') next = tabs.length - 1;
        if (next >= 0) {
          ev.preventDefault();
          select(tabs[next]);
        }
      });
      tabs.forEach((t) => t.addEventListener('click', () => select(t, false)));

      function syncFromHash() {
        const id = location.hash.slice(1) || 'combos';
        const tab = tabs.find((t) => t.id === `tab-${id}`);
        if (tab && tab.getAttribute('aria-selected') !== 'true') select(tab, false);
      }
      window.addEventListener('hashchange', syncFromHash);
      syncFromHash();
    });
  </script>
</BaseLayout>

<style>
  .page-head {
    margin-bottom: 1.2rem;
  }
  .page-head h1 {
    margin: 0 0 0.3rem;
    color: var(--accent);
  }
  .page-head p {
    margin: 0;
    color: var(--text-dim);
    font-size: 0.9rem;
  }
  .page-head .ch-links {
    margin-top: 0.4rem;
    font-size: 0.85rem;
  }

  .tab-bar {
    display: flex;
    gap: 0.4rem;
    border-bottom: 2px solid var(--border-strong);
    margin-bottom: 1.2rem;
  }
  .tab-bar [role='tab'] {
    font-family: var(--font-pixel);
    font-size: 0.85rem;
    padding: 0.5em 1em;
    border: 2px solid var(--border-strong);
    border-bottom: 0;
    background: var(--bg-sunken);
    color: var(--text-dim);
    cursor: pointer;
    margin-bottom: -2px;
  }
  .tab-bar [role='tab'][aria-selected='true'] {
    background: var(--panel);
    color: var(--accent);
    border-color: var(--accent);
  }
  .tab-bar [role='tab']:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .tab-panel:focus-visible {
    outline: none;
  }

  .tab-desc {
    font-size: 0.85rem;
    color: var(--text-dim);
    margin: 0 0 1rem;
    border-left: 3px solid var(--accent);
    padding: 0.3rem 0.7rem;
    background: var(--bg-sunken);
  }
  .tab-desc strong {
    color: var(--accent);
  }
  .hint {
    font-size: 0.85rem;
    color: var(--text-faint);
    margin: 0 0 1rem;
  }
  .sp-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 0.9rem;
  }
  .sp-card {
    padding: 0.8rem 0.9rem;
  }
  .sp-title {
    font-family: var(--font-pixel);
    font-size: 0.95rem;
  }
  .sp-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin: 0.5rem 0;
  }
  .sp-choices {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.85rem;
  }
  .sp-choices li {
    display: flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.2rem 0;
    color: var(--text-dim);
  }
  .dot {
    width: 8px;
    height: 8px;
    background: var(--border-strong);
    flex: none;
  }
  .dot[data-risk='低'] {
    background: var(--risk-low);
  }
  .dot[data-risk='中'] {
    background: var(--risk-mid);
  }
  .dot[data-risk='高'] {
    background: var(--risk-high);
  }
</style>
