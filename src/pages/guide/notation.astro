---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sequence from '../../components/notation/Sequence.astro';

const directions = [
  ['7', '↖ 左上'],
  ['8', '↑ 上'],
  ['9', '↗ 右上'],
  ['4', '← 後ろ'],
  ['5', '・ ニュートラル'],
  ['6', '→ 前'],
  ['1', '↙ 左下'],
  ['2', '↓ しゃがみ'],
  ['3', '↘ 右下'],
];

const buttons = [
  ['LP', '弱パンチ（シアン）'],
  ['MP', '中パンチ（イエロー）'],
  ['HP', '強パンチ（レッド）'],
  ['LK', '弱キック'],
  ['MK', '中キック'],
  ['HK', '強キック'],
  ['236KK', 'OD（オーバードライブ）＝ボタン2つ（PP / KK）。技名に「OD」が付く'],
];

const modern = [
  ['236MP', '中ランヴェルセ（クラシック）'],
  ['2SP', '同・モダン（方向 ＋ SP。SP＝必殺技ボタン、オレンジ）'],
  ['4M', 'モダンの通常/特殊技（方向 ＋ 弱中強。P/K は付かない）'],
  ['6AS SP', 'OD 必殺技（モダンは 方向 ＋ AUTO ＋ SP。AUTO＝アシストボタン）'],
  ['2SP H', 'SA（モダンは 方向 ＋ SP ＋ 強）'],
];

const modifiers = [
  ['j.HK', 'ジャンプ攻撃（j.）'],
  ['dl.5HP', 'ディレイ（dl.）'],
  ['2LP~2LP', '目押しリンク（~）'],
  ['5MP > 236MP', 'キャンセル（>）'],
  ['[4]6HK', 'ため（[4]）'],
  ['DR', 'ドライブラッシュ（緑）'],
  ['DRC', 'キャンセルドライブラッシュ（緑）'],
  ['236236P', 'SA（スーパーアーツ）'],
];

const examples = [
  ['236MP', '中ランヴェルセ'],
  ['214LK', '弱デガジェ'],
  ['63214P', 'マネージュ・ドレ（コマンド投げ）'],
  ['4MK~MK', 'アン・オー → 派生中K'],
  ['5MP > DRC 2MP', '5中P キャンセルドライブラッシュ 2中P'],
];
---

<BaseLayout title="表記の見方" crumbs={[{ label: '表記の見方' }]}>
  <article class="stack" style="--gap:1.8rem">
    <header>
      <h1>コマンド表記の見方</h1>
      <p>
        このサイトはコマンドを <strong>テンキー表記</strong>（236＝波動コマンド など）で持ち、
        <strong>アイコン</strong>と<strong>テキスト</strong>の 2 通りで表示します。
        右上のトグルでいつでも切り替えられます（設定は記憶されます）。
      </p>
    </header>

    <section>
      <h2>方向（テンキー）</h2>
      <div class="grid dirs">
        {
          directions.map(([n, label]) => (
            <div class="cell">
              <Sequence command={n} />
              <span class="lbl">{n} — {label}</span>
            </div>
          ))
        }
      </div>
    </section>

    <section>
      <h2>ボタン</h2>
      <div class="grid">
        {
          buttons.map(([b, label]) => (
            <div class="cell">
              <Sequence command={b} />
              <span class="lbl">{label}</span>
            </div>
          ))
        }
      </div>
      <p class="fine">
        公式 SF6 に合わせて 弱＝シアン / 中＝イエロー / 強＝レッド。
        OD（オーバードライブ）はボタン2つ ＋ 「OD」表記、色は付けません。
      </p>
    </section>

    <section>
      <h2>クラシック / モダン</h2>
      <p class="fine">
        コンボフローとパーツ詳細の <strong>クラシック / モダン</strong> トグルで表記が切り替わります。
        モダンの必殺技は「方向 ＋ <code>SP</code>」、OD は「方向 ＋ <code>AUTO</code> ＋ <code>SP</code>」。
        技ごとの正確なモダン入力は技辞典（<code>moves</code>）から取得します（未整備の技は自動推定・暫定表示）。
      </p>
      <table class="spec">
        <tbody>
          {
            modern.map(([c, label]) => (
              <tr>
                <th><Sequence command={c} /></th>
                <td>{label}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </section>

    <section>
      <h2>記号・修飾子</h2>
      <div class="grid wide">
        {
          modifiers.map(([c, label]) => (
            <div class="cell">
              <Sequence command={c} />
              <span class="lbl">{label}</span>
            </div>
          ))
        }
      </div>
    </section>

    <section>
      <h2>マノンの例</h2>
      <table class="spec">
        <tbody>
          {
            examples.map(([c, label]) => (
              <tr>
                <th><Sequence command={c} /></th>
                <td>{label}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </section>
  </article>
</BaseLayout>

<style>
  h1 {
    color: var(--accent);
    margin: 0 0 0.5rem;
  }
  h2 {
    font-size: 1rem;
    border-bottom: 2px solid var(--border-strong);
    padding-bottom: 0.25rem;
    margin: 0 0 0.9rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(150px, 100%), 1fr));
    gap: 0.5rem;
  }
  .grid.wide {
    grid-template-columns: repeat(auto-fill, minmax(min(200px, 100%), 1fr));
  }
  .grid.dirs {
    grid-template-columns: repeat(3, 1fr);
    max-width: 360px;
  }
  .cell {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0.6rem;
    border: 1px solid var(--border);
    background: var(--bg-sunken);
    font-size: 1.1rem;
  }
  .cell .lbl {
    font-size: 0.76rem;
    color: var(--text-dim);
    font-family: var(--font-body);
  }
  .fine {
    font-size: 0.8rem;
    color: var(--text-faint);
  }
</style>
